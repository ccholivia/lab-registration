{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lab-registration",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lab-registration-db",
    "database_id": "cb761861-f866-4b13-b27c-c23b13031668",
    "migrations_dir": "migrations"
  }]
}
